# Comma-separated list of origins allowed to call the API.
# Local development uses the Vite dev server; set your deployed frontend
# origin(s) in production. Do not use "*" in production.
VITALSCAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Target measurement duration advertised to the client, in seconds.
VITALSCAN_MEASUREMENT_SECONDS=30

# Shortest signal the pipeline will attempt to analyse, in seconds.
VITALSCAN_MIN_ANALYSIS_SECONDS=20

# Hard cap on the number of per-frame samples accepted in one request.
VITALSCAN_MAX_SAMPLES=20000

# Reference-video validation endpoint (developer tool). Set to "false" to
# disable /api/measurement/process-video in production.
VITALSCAN_ENABLE_VIDEO_ENDPOINT=true
VITALSCAN_MAX_VIDEO_BYTES=83886080

# Notebook defaults used by the video-file path only (cell 4 of the notebook).
VITALSCAN_VIDEO_DISCARD_SECONDS=5
VITALSCAN_VIDEO_DURATION_SECONDS=60
