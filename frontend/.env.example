# Base URL of the VitalScan API. No trailing slash.
# Local development: http://localhost:8000
# Production: https://your-backend-host
VITE_API_BASE_URL=http://localhost:8000

# How long to wait for the analysis response before giving up, in milliseconds.
VITE_API_TIMEOUT_MS=45000

# Target measurement duration in seconds. Keep this in sync with the backend's
# VITALSCAN_MEASUREMENT_SECONDS.
VITE_MEASUREMENT_SECONDS=30
